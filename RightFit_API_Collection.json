{
  "info": {
    "_postman_id": "rightfit-api-v2",
    "name": "RightFit API Collection",
    "description": "Complete API collection for RightFit Resource Allocation Platform with Authentication and OTP Recovery",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Authentication - Login & Tokens",
      "item": [
        {
          "name": "1. Login (Step 1: Email & Password)",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\"employeeId\": \"1\",\"password\": \"ForgotPassword@456\"}"},
            "url": {"raw": "{{base_url}}/api/auth/login", "host": ["{{base_url}}"], "path": ["api", "auth", "login"]},
            "description": "Login with employee ID and password. OTP will be sent to registered email."
          }
        },
        {
          "name": "2. Verify Login OTP (Step 2: Complete Login)",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\"sessionId\": 1,\"otp\": \"123456\"}"},
            "url": {"raw": "{{base_url}}/api/auth/verify-login-otp", "host": ["{{base_url}}"], "path": ["api", "auth", "verify-login-otp"]},
            "description": "Submit OTP from email to complete login. Returns JWT tokens."
          }
        },
        {
          "name": "3. Get User Profile (/me)",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{access_token}}"}],
            "url": {"raw": "{{base_url}}/api/auth/me", "host": ["{{base_url}}"], "path": ["api", "auth", "me"]},
            "description": "Get authenticated user profile with complete details."
          }
        },
        {
          "name": "4. Refresh Access Token",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "Authorization", "value": "Bearer {{access_token}}"}],
            "body": {"mode": "raw", "raw": "{\"refreshToken\": \"{{refresh_token}}\"}"},
            "url": {"raw": "{{base_url}}/api/auth/refresh-token", "host": ["{{base_url}}"], "path": ["api", "auth", "refresh-token"]},
            "description": "Refresh access token using valid refresh token. User ownership validated."
          }
        },
        {
          "name": "5. Logout",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "Authorization", "value": "Bearer {{access_token}}"}],
            "body": {"mode": "raw", "raw": "{\"refreshToken\": \"{{refresh_token}}\"}"},
            "url": {"raw": "{{base_url}}/api/auth/logout", "host": ["{{base_url}}"], "path": ["api", "auth", "logout"]},
            "description": "Logout and revoke refresh token. User ownership validated."
          }
        }
      ]
    },
    {
      "name": "Forgot Password - 3 Step Process (Public)",
      "item": [
        {
          "name": "Step 1: Request Forgot Password OTP",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\"email\": \"rajesh.kumar@techcorp.com\"}"},
            "url": {"raw": "{{base_url}}/api/auth/forgot-password/step1", "host": ["{{base_url}}"], "path": ["api", "auth", "forgot-password", "step1"]},
            "description": "Request password reset OTP. Searches for account by email and sends OTP to registered email."
          }
        },
        {
          "name": "Step 2: Verify Forgot Password OTP",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\"email\": \"rajesh.kumar@techcorp.com\",\"otp\": \"123456\"}"},
            "url": {"raw": "{{base_url}}/api/auth/forgot-password/step2", "host": ["{{base_url}}"], "path": ["api", "auth", "forgot-password", "step2"]},
            "description": "Verify OTP sent to email. OTP must be valid and not expired."
          }
        },
        {
          "name": "Step 3: Reset Password",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\"email\": \"rajesh.kumar@techcorp.com\",\"newPassword\": \"NewPassword@789\",\"confirmPassword\": \"NewPassword@789\"}"},
            "url": {"raw": "{{base_url}}/api/auth/forgot-password/step3", "host": ["{{base_url}}"], "path": ["api", "auth", "forgot-password", "step3"]},
            "description": "Reset password after OTP verification. New password must match confirm password."
          }
        }
      ]
    },
    {
      "name": "Reset Password - Authenticated Users Only",
      "item": [
        {
          "name": "Reset Password with Old Password",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "Authorization", "value": "Bearer {{access_token}}"}],
            "body": {"mode": "raw", "raw": "{\"oldPassword\": \"Admin@123\",\"newPassword\": \"UpdatedPassword@123\",\"confirmPassword\": \"UpdatedPassword@123\"}"},
            "url": {"raw": "{{base_url}}/api/auth/reset-password", "host": ["{{base_url}}"], "path": ["api", "auth", "reset-password"]},
            "description": "Reset password for authenticated user. Old password must be correct. Requires active login session."
          }
        }
      ]
    },
    {
      "name": "Email Verification",
      "item": [
        {
          "name": "Verify Email with OTP",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\"email\": \"user@example.com\",\"otp\": \"123456\"}"},
            "url": {"raw": "{{base_url}}/api/auth/verify-email-otp", "host": ["{{base_url}}"], "path": ["api", "auth", "verify-email-otp"]},
            "description": "Verify email during registration with OTP sent to email address."
          }
        }
      ]
    },
    {
      "name": "Security Tests",
      "item": [
        {
          "name": "Test: Invalid Password Login",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\"employeeId\": \"1\",\"password\": \"WrongPassword\"}"},
            "url": {"raw": "{{base_url}}/api/auth/login", "host": ["{{base_url}}"], "path": ["api", "auth", "login"]},
            "description": "Security test: Invalid password should be rejected with 401 error."
          }
        },
        {
          "name": "Test: Cross-User Token Prevention (Refresh)",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "Authorization", "value": "Bearer {{manager_access_token}}"}],
            "body": {"mode": "raw", "raw": "{\"refreshToken\": \"{{admin_refresh_token}}\"}"},
            "url": {"raw": "{{base_url}}/api/auth/refresh-token", "host": ["{{base_url}}"], "path": ["api", "auth", "refresh-token"]},
            "description": "Security test: Manager cannot use Admin's refresh token. Should return 401 'Cannot refresh another user's token'."
          }
        },
        {
          "name": "Test: Cross-User Logout Prevention",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "Authorization", "value": "Bearer {{manager_access_token}}"}],
            "body": {"mode": "raw", "raw": "{\"refreshToken\": \"{{admin_refresh_token}}\"}"},
            "url": {"raw": "{{base_url}}/api/auth/logout", "host": ["{{base_url}}"], "path": ["api", "auth", "logout"]},
            "description": "Security test: Manager cannot logout Admin's session. Should return 401 'Cannot logout another user's session'."
          }
        },
        {
          "name": "Test: Wrong OTP Rejection",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\"email\": \"rajesh.kumar@techcorp.com\",\"otp\": \"000000\"}"},
            "url": {"raw": "{{base_url}}/api/auth/forgot-password/step2", "host": ["{{base_url}}"], "path": ["api", "auth", "forgot-password", "step2"]},
            "description": "Security test: Wrong OTP should be rejected with 400 'Invalid or expired OTP'."
          }
        },
        {
          "name": "Test: Non-existent Email Forgot Password",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\"email\": \"nonexistent@fake.com\"}"},
            "url": {"raw": "{{base_url}}/api/auth/forgot-password/step1", "host": ["{{base_url}}"], "path": ["api", "auth", "forgot-password", "step1"]},
            "description": "Security test: Non-existent email returns generic 'No account found' error (prevents email enumeration)."
          }
        },
        {
          "name": "Test: Reset Password Requires Authentication",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\"oldPassword\": \"Admin@123\",\"newPassword\": \"New@123\",\"confirmPassword\": \"New@123\"}"},
            "url": {"raw": "{{base_url}}/api/auth/reset-password", "host": ["{{base_url}}"], "path": ["api", "auth", "reset-password"]},
            "description": "Security test: Reset password without authentication returns 401 'You must be logged in'."
          }
        }
      ]
    }
  ],
  "variable": [
    {"key": "base_url", "value": "http://localhost:8081", "type": "string"},
    {"key": "access_token", "value": "", "type": "string", "description": "JWT access token from login/verify-login-otp"},
    {"key": "refresh_token", "value": "", "type": "string", "description": "JWT refresh token from login/verify-login-otp"},
    {"key": "admin_access_token", "value": "", "type": "string", "description": "Admin user access token"},
    {"key": "admin_refresh_token", "value": "", "type": "string", "description": "Admin user refresh token"},
    {"key": "manager_access_token", "value": "", "type": "string", "description": "Manager user access token"},
    {"key": "manager_refresh_token", "value": "", "type": "string", "description": "Manager user refresh token"}
  ]
}
