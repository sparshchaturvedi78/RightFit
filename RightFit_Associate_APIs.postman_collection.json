{
  "info": {
    "name": "RightFit - Associate Self-Service Phase",
    "description": "Associate phase only: basic profile, skills, certifications (with document upload), preferences, temporary-unavailability workflow, and skill/certification catalog management. No auth endpoints here - log in with your existing auth collection as EMP004 (Associate), EMP002 (RMG) and EMP001 (Admin), and paste the tokens below.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8081" },
    { "key": "associateToken", "value": "" },
    { "key": "rmgToken", "value": "" },
    { "key": "adminToken", "value": "" },
    { "key": "skillName", "value": "Java", "description": "Add/Update/Remove Skill address the skill by name, not a numeric id - seeded names include Java, Python, React, AWS, Docker..." },
    { "key": "skillId", "value": "1", "description": "Admin catalog section only (Update/Retire Skill) - numeric catalog row id, seeded 1=Java ... 10=AWS" },
    { "key": "certificationName", "value": "Oracle Java Programmer", "description": "Add Certification addresses the catalog entry by name - seeded names include AWS Solutions Architect, AWS Developer Associate, Oracle Java Programmer" },
    { "key": "certificationId", "value": "2", "description": "Admin catalog section only (Update/Retire Certification) - numeric catalog row id, seeded 1,2,3" },
    { "key": "employeeCertificationId", "value": "", "description": "Fill from the Add Certification response - Update/Document/Delete Certification still need this row id, not the name, since one employee can hold several records with the same certification name (renewals)" },
    { "key": "availabilityRequestId", "value": "", "description": "Fill from the Request Unavailability response" }
  ],
  "item": [
    {
      "name": "Basic Profile",
      "item": [
        {
          "name": "Get My Profile",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{associateToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/associate/profile", "host": ["{{baseUrl}}"], "path": ["api", "associate", "profile"] }
          }
        },
        {
          "name": "Update My Profile (phone only)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{associateToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"phone\": \"+91-9000000000\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/associate/profile", "host": ["{{baseUrl}}"], "path": ["api", "associate", "profile"] },
            "description": "Only phone is editable - grade/designation/RMG/status etc. stay Admin-only."
          }
        }
      ]
    },
    {
      "name": "Skills",
      "item": [
        {
          "name": "List My Skills",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{associateToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/associate/skills", "host": ["{{baseUrl}}"], "path": ["api", "associate", "skills"] }
          }
        },
        {
          "name": "Add Skill",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{associateToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"skillName\": \"{{skillName}}\",\n  \"proficiencyLevel\": 7,\n  \"yearsOfExperience\": 3,\n  \"lastUsedDate\": \"2025-01-01\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/associate/skills", "host": ["{{baseUrl}}"], "path": ["api", "associate", "skills"] },
            "description": "Add by name, not catalog id - browse 'List Skills (active only)' under Skill Catalog first if you need to see what's available. 409 DUPLICATE_ENTITY if you already have this skill; 400 if it's been retired."
          }
        },
        {
          "name": "Update Skill",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{associateToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"proficiencyLevel\": 9\n}" },
            "url": { "raw": "{{baseUrl}}/api/associate/skills/{{skillName}}", "host": ["{{baseUrl}}"], "path": ["api", "associate", "skills", "{{skillName}}"] },
            "description": "Addressed by skill name - you only ever have one row per skill, so no internal id needed."
          }
        },
        {
          "name": "Remove Skill",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{associateToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/associate/skills/{{skillName}}", "host": ["{{baseUrl}}"], "path": ["api", "associate", "skills", "{{skillName}}"] },
            "description": "204 No Content on success."
          }
        }
      ]
    },
    {
      "name": "Certifications",
      "item": [
        {
          "name": "List My Certifications",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{associateToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/associate/certifications", "host": ["{{baseUrl}}"], "path": ["api", "associate", "certifications"] }
          }
        },
        {
          "name": "Add Certification (with file)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{associateToken}}" }],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "certificationName", "value": "{{certificationName}}", "type": "text" },
                { "key": "obtainedDate", "value": "2024-01-15", "type": "text" },
                { "key": "expiryDate", "value": "2027-01-15", "type": "text" },
                { "key": "file", "type": "file", "src": [], "description": "Optional - PDF, PNG or JPEG only, max 10MB. Select a file here or remove this field entirely." }
              ]
            },
            "url": { "raw": "{{baseUrl}}/api/associate/certifications", "host": ["{{baseUrl}}"], "path": ["api", "associate", "certifications"] },
            "description": "Add by catalog name, not id - issuer/description come from the catalog entry you name here, never re-entered. 400 if it's been retired. Copy the returned \"id\" into employeeCertificationId for the requests below - update/document/delete still need this row id (not the name), since you can hold several records with the same certification name over time (renewals)."
          }
        },
        {
          "name": "Update Certification (optionally replace file)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Authorization", "value": "Bearer {{associateToken}}" }],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "expiryDate", "value": "2028-01-15", "type": "text" },
                { "key": "file", "type": "file", "src": [], "description": "Leave unset to keep the existing file; select a new one to replace it." }
              ]
            },
            "url": { "raw": "{{baseUrl}}/api/associate/certifications/{{employeeCertificationId}}", "host": ["{{baseUrl}}"], "path": ["api", "associate", "certifications", "{{employeeCertificationId}}"] }
          }
        },
        {
          "name": "Get Certification Document",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{associateToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/associate/certifications/{{employeeCertificationId}}/document", "host": ["{{baseUrl}}"], "path": ["api", "associate", "certifications", "{{employeeCertificationId}}", "document"] },
            "description": "Streams the file back (inline). 400 if this certification has no uploaded document. Also callable with adminToken (read-only, regardless of the on-behalf-edit decision)."
          }
        },
        {
          "name": "Remove Certification",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{associateToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/associate/certifications/{{employeeCertificationId}}", "host": ["{{baseUrl}}"], "path": ["api", "associate", "certifications", "{{employeeCertificationId}}"] },
            "description": "204 No Content. Deletes the stored file too, if one was attached."
          }
        }
      ]
    },
    {
      "name": "Preferences",
      "item": [
        {
          "name": "Get My Preferences",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{associateToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/associate/preferences", "host": ["{{baseUrl}}"], "path": ["api", "associate", "preferences"] },
            "description": "Returns {} the first time - the row is created lazily."
          }
        },
        {
          "name": "Update My Preferences",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{associateToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"preferredTechnology\": \"Java, Spring Boot\",\n  \"preferredDomain\": \"Banking\",\n  \"preferredLocation\": \"Bangalore\",\n  \"preferredWorkMode\": \"Remote\",\n  \"preferredProjectType\": \"Product\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/associate/preferences", "host": ["{{baseUrl}}"], "path": ["api", "associate", "preferences"] },
            "description": "Full replace - omit a field (or send null) to clear it back to no-preference."
          }
        }
      ]
    },
    {
      "name": "Availability - Self Service",
      "item": [
        {
          "name": "Get My Availability History",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{associateToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/associate/availability", "host": ["{{baseUrl}}"], "path": ["api", "associate", "availability"] }
          }
        },
        {
          "name": "Request Unavailability",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{associateToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"expectedReturnDate\": \"2026-12-01\",\n  \"reason\": \"Medical leave\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/associate/availability/request-unavailability", "host": ["{{baseUrl}}"], "path": ["api", "associate", "availability", "request-unavailability"] },
            "description": "Only one date - the expected return date. Takes effect immediately once RMG approves it (no future-dated start). 400 if you already have a request PENDING. Copy the returned \"id\" into availabilityRequestId."
          }
        },
        {
          "name": "Cancel My Pending Request",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{associateToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/associate/availability/{{availabilityRequestId}}/cancel-request", "host": ["{{baseUrl}}"], "path": ["api", "associate", "availability", "{{availabilityRequestId}}", "cancel-request"] },
            "description": "Only works while verificationStatus is still PENDING - 400 otherwise."
          }
        },
        {
          "name": "Return Early",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{associateToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/associate/availability/return-early", "host": ["{{baseUrl}}"], "path": ["api", "associate", "availability", "return-early"] },
            "description": "Only works while you're currently UNAVAILABLE (i.e. your request was approved first). Restores pool eligibility and resumes the same bench clock immediately, without waiting for the nightly job."
          }
        }
      ]
    },
    {
      "name": "Availability - RMG Verification",
      "item": [
        {
          "name": "List Pending Requests",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{rmgToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/rmg/availability-requests", "host": ["{{baseUrl}}"], "path": ["api", "rmg", "availability-requests"] },
            "description": "RMG sees pending requests for their own associates (plus anyone unassigned). Admin sees all."
          }
        },
        {
          "name": "Approve Request",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Authorization", "value": "Bearer {{rmgToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/rmg/availability-requests/{{availabilityRequestId}}/approve", "host": ["{{baseUrl}}"], "path": ["api", "rmg", "availability-requests", "{{availabilityRequestId}}", "approve"] },
            "description": "Flips the employee UNAVAILABLE now, exits the Resource Pool if they were in it, and pauses their bench clock if they're currently on the bench."
          }
        },
        {
          "name": "Reject Request",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{rmgToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"reason\": \"Coverage gap, please defer\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/rmg/availability-requests/{{availabilityRequestId}}/reject", "host": ["{{baseUrl}}"], "path": ["api", "rmg", "availability-requests", "{{availabilityRequestId}}", "reject"] }
          }
        }
      ]
    },
    {
      "name": "Skill Catalog",
      "item": [
        {
          "name": "List Skills (active only)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{associateToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/admin/skills?activeOnly=true", "host": ["{{baseUrl}}"], "path": ["api", "admin", "skills"], "query": [{ "key": "activeOnly", "value": "true" }] },
            "description": "Any employee can browse this (to pick one when adding a skill)."
          }
        },
        {
          "name": "List Skills (including retired)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/admin/skills?activeOnly=false", "host": ["{{baseUrl}}"], "path": ["api", "admin", "skills"], "query": [{ "key": "activeOnly", "value": "false" }] }
          }
        },
        {
          "name": "Create Skill (Admin only)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"skillName\": \"Rust\",\n  \"category\": \"BACKEND\",\n  \"description\": \"Rust programming\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/admin/skills", "host": ["{{baseUrl}}"], "path": ["api", "admin", "skills"] },
            "description": "409 if the name already exists. Expect 403 if called with associateToken."
          }
        },
        {
          "name": "Update Skill (Admin only)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"description\": \"Rust systems programming\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/admin/skills/{{skillId}}", "host": ["{{baseUrl}}"], "path": ["api", "admin", "skills", "{{skillId}}"] }
          }
        },
        {
          "name": "Retire Skill (Admin only)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/admin/skills/{{skillId}}/retire", "host": ["{{baseUrl}}"], "path": ["api", "admin", "skills", "{{skillId}}", "retire"] },
            "description": "Hides it from the active-only browse list; existing employee_skills rows referencing it keep working. Pick a skill id nobody needs for the rest of this run before retiring it."
          }
        }
      ]
    },
    {
      "name": "Certification Catalog",
      "item": [
        {
          "name": "List Certifications (active only)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{associateToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/admin/certifications?activeOnly=true", "host": ["{{baseUrl}}"], "path": ["api", "admin", "certifications"], "query": [{ "key": "activeOnly", "value": "true" }] }
          }
        },
        {
          "name": "Create Certification (Admin only)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"certificationName\": \"Azure Fundamentals\",\n  \"issuingOrganization\": \"Microsoft\",\n  \"description\": \"AZ-900\",\n  \"validYears\": 3\n}" },
            "url": { "raw": "{{baseUrl}}/api/admin/certifications", "host": ["{{baseUrl}}"], "path": ["api", "admin", "certifications"] }
          }
        },
        {
          "name": "Update Certification (Admin only)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"description\": \"Microsoft Azure Fundamentals (AZ-900)\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/admin/certifications/{{certificationId}}", "host": ["{{baseUrl}}"], "path": ["api", "admin", "certifications", "{{certificationId}}"] }
          }
        },
        {
          "name": "Retire Certification (Admin only)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/admin/certifications/{{certificationId}}/retire", "host": ["{{baseUrl}}"], "path": ["api", "admin", "certifications", "{{certificationId}}", "retire"] },
            "description": "Pick a certification id nobody needs for the rest of this run before retiring it."
          }
        }
      ]
    }
  ]
}
