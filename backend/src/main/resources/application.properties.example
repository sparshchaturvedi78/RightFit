# ============================================================================
# RightFit - Application Configuration Template
# ============================================================================
# Copy this file to application.properties and fill in your actual values
# application.properties should NOT be committed to git

# Database Configuration
spring.datasource.url=jdbc:postgresql://localhost:5432/rightfit
spring.datasource.username=your_db_username
spring.datasource.password=your_db_password
spring.datasource.driver-class-name=org.postgresql.Driver

# HikariCP Connection Pool
spring.datasource.hikari.maximum-pool-size=10
spring.datasource.hikari.minimum-idle=2
spring.datasource.hikari.connection-timeout=30000
spring.datasource.hikari.idle-timeout=600000
spring.datasource.hikari.max-lifetime=1800000

# JPA / Hibernate Configuration
spring.jpa.database=POSTGRESQL
spring.jpa.hibernate.ddl-auto=none
spring.jpa.hibernate.generate_statistics=false
spring.jpa.properties.hibernate.format_sql=false
spring.jpa.show-sql=false
spring.jpa.properties.hibernate.jdbc.time_zone=UTC

# Flyway Migration Configuration
spring.flyway.enabled=true
spring.flyway.locations=classpath:db/migration
spring.flyway.baseline-on-migrate=false
spring.flyway.validate-on-migrate=false

# JWT Configuration
jwt.secret=your-secure-jwt-secret-minimum-32-bytes
jwt.access-token-expiration-ms=900000
jwt.refresh-token-expiration-ms=604800000

# Logging Configuration
logging.level.root=INFO
logging.level.com.rightFit=DEBUG
logging.level.org.springframework.web=INFO
logging.level.org.flywaydb=DEBUG
logging.level.org.springframework.boot.autoconfigure.flyway=DEBUG
logging.level.org.springframework.boot.autoconfigure.jdbc=DEBUG

# Email Configuration
spring.mail.host=smtp.gmail.com
spring.mail.port=587
spring.mail.username=your-email@gmail.com
spring.mail.password=your-app-password
spring.mail.properties.mail.smtp.auth=true
spring.mail.properties.mail.smtp.starttls.enable=true
spring.mail.properties.mail.smtp.starttls.required=true

app.mail.enabled=false
app.mail.from=your-email@gmail.com

# OTP Configuration
app.otp.expiry-minutes=10
app.otp.length=6

# Frontend Configuration
app.frontend.url=http://localhost:5173

# Server Configuration
server.port=8081
